  "license": "MIT",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.27.0",
    "ky": "^2.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "discord-api-types": "^0.38.57",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
