{
  "name": "awwbot",
  "version": "1.0.0",
  "description": "A simple discord bot that uses intents to post pictures from r/aww",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "wrangler dev src/server.ts",
    "ngrok": "ngrok http 8787",
    "test": "c8 mocha test",
    "fix": "eslint --fix .",
    "lint": "eslint .",
    "register": "node script/register.ts",
    "deploy": "wrangler deploy",
    "build:commands": "node script/builder.ts"
  },
  "keywords": [],
